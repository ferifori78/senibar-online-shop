# ==========================================================================
# Senobar — production environment
#
#   cp .env.production.example .env
#   then fill in every value marked CHANGE ME
#
# docker compose reads this file automatically. Never commit the filled copy.
# ==========================================================================

# --- Django ---------------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE ME

DEBUG=False

# Every hostname the site answers on. No spaces.
ALLOWED_HOSTS=senobar.coffee,www.senobar.coffee

# --- Database -------------------------------------------------------------
POSTGRES_DB=senobar
POSTGRES_USER=senobar
POSTGRES_PASSWORD=CHANGE ME

# --- Public URLs ----------------------------------------------------------
# Used in emails and as the payment gateway's return address.
FRONTEND_URL=https://senobar.coffee
CORS_ALLOWED_ORIGINS=https://senobar.coffee,https://www.senobar.coffee

# The port Nginx binds on the host. Behind a reverse proxy, use 8080.
WEB_PORT=80

# --- Payments -------------------------------------------------------------
# PAYMENT_GATEWAYS is what checkout offers the customer, in display order.
# PAYMENT_GATEWAY is the fallback when the client picks nothing.
#
# A gateway listed here without its credentials is silently dropped from the
# picker, so it is safe to list both before the second account is approved.
#
# "mock" never charges anyone — leave it out of PAYMENT_GATEWAYS in production
# or a customer could select it and settle an order for free.
PAYMENT_GATEWAYS=zarinpal,bitpay
PAYMENT_GATEWAY=zarinpal

# --- ZarinPal -------------------------------------------------------------
# merchant_id: the UUID from Settings → Gateways in the ZarinPal panel.
# access_token: from the active-sessions page. Only needed for refunds and
#   transaction queries — taking payments works without it.
# Set ZARINPAL_SANDBOX=True to use sandbox.zarinpal.com while testing.
ZARINPAL_MERCHANT_ID=
ZARINPAL_ACCESS_TOKEN=
ZARINPAL_SANDBOX=False

# --- BitPay ---------------------------------------------------------------
# A 52-character key from the BitPay panel (پنل کاربری → درگاه‌ها → کد API).
# BitPay checks that the callback URL matches the domain registered against
# the key, subdomain included — a mismatch returns error -4.
#
# With BITPAY_SANDBOX=True the driver uses bitpay.ir/payment-test and BitPay's
# published test key, so the flow works before the account is approved.
BITPAY_API_KEY=
BITPAY_SANDBOX=False

# --- Email ----------------------------------------------------------------
# The console backend prints to the log. For real delivery:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Senobar <hello@senobar.coffee>
ROASTERY_REPORT_EMAILS=roastery@senobar.coffee

# --- SMS ------------------------------------------------------------------
SMS_BACKEND=console
SMS_SENDER=Senobar
KAVENEGAR_API_KEY=

# --- Celery ---------------------------------------------------------------
# Workers per container. Start at 4 and watch memory.
CELERY_CONCURRENCY=4
